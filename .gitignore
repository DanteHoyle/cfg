# Ignore everything at root level
/*
# Whitelist root-level files
!/.zshenv
!/.editorconfig
!/.gitignore
!/scripts/
/scripts/*
!/scripts/cfg/
!/scripts/cfg/**
!/.github/
/.github/*
!/.github/README.md
!/.vim/
/.vim/*
!/.vim/vimrc
!/.config/
/.config/*
!/.config/zsh/
!/.config/zsh/**
.config/zsh/local.zsh
.config/zsh/.zcompdump
!/.config/ghostty
!/.config/tmux/
/.config/tmux/*
!/.config/tmux/.conf
# Sanity Check, blacklist sensitive directories again
.config/git/
.ssh/
.gnupg/
.local/share/keyrings/
